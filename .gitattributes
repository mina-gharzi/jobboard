# Normalize all text files to LF in the repository (auto-detected)
* text=auto

# Source code — always store and check out as LF on every platform
*.ts   text eol=lf
*.tsx  text eol=lf
*.css  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.mjs  text eol=lf
*.js   text eol=lf

# Binary assets — never normalize
*.ico  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.woff  binary
*.woff2 binary