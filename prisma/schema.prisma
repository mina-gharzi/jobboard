generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          String    @default("CANDIDATE")
  accounts      Account[]
  sessions      Session[]
  jobs          Job[]     @relation("EmployerJobs")
  applications  Application[] @relation("CandidateApplications")

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  issuer                String?
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Job {
  id           String        @id @default(cuid())
  employerId   String
  employer     User          @relation("EmployerJobs", fields: [employerId], references: [id])
  title        String
  slug         String        @unique
  description  String
  category     String
  city         String
  remoteType   RemoteType
  salaryMin    Int?
  salaryMax    Int?
  status       JobStatus     @default(PUBLISHED)
  createdAt    DateTime      @default(now())
  applications Application[]

  @@index([status, category, city])
  @@index([employerId])
}

model Application {
  id          String            @id @default(cuid())
  jobId       String
  candidateId String
  candidate   User              @relation("CandidateApplications", fields: [candidateId], references: [id])
  coverLetter String?
  status      ApplicationStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  job         Job               @relation(fields: [jobId], references: [id])

  @@unique([jobId, candidateId])
  @@index([candidateId])
}

enum Role {
  CANDIDATE
  EMPLOYER
}

enum RemoteType {
  ONSITE
  REMOTE
  HYBRID
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum ApplicationStatus {
  PENDING
  REVIEWED
  ACCEPTED
  REJECTED
}
